cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'chan-delorean' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               chan-delorean

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.0.1

-- A short (one-line) description of the package.
synopsis:           Archive/Time Machine for imageboard content

-- A longer description of the package.
-- description:

-- URL for the project homepage or repository.
homepage:           https://leftychan.net/tech/res/12527.html

-- The license under which the package is released.
license:            AGPL-3.0-or-later

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             towards-a-new-leftypol

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         paul_cockshott@protonmail.com

-- A copyright notice.
-- copyright:
category:           Web
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall -rtsopts -threaded -static -prof -fprof-auto

executable chan-delorean-consoomer
    -- Import common warning flags.
    import:           warnings

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    other-modules:
                      Lib
                      Network.Api.JSONParsing
                      Network.Api.JSONPost
                      Network.Api.JSONCommonTypes
                      Network.Api.JSONExtraFile
                      SitesType
                      BoardsType
                      ThreadType
                      Common.PostsType
                      Common.AttachmentType
                      Common.Network.HttpClient
                      Hash
                      Data.WordUtil
                      Network.DataClient
                      Network.DataClientTypes
                      Network.GetLatestPostsPerBoardResponse
                      Common.Server.ConsumerSettings
                      Common.Server.JSONSettings
                      Common.Parsing.FlexibleJsonResponseParser
                      PriorityQueue
                      Sync
                      BoardQueueElem
                      Lib2
                      ClientAPI
                      Clients.LainJSONClient
                      Clients.TinyboardHTML
                      Common.Network.BoardType
                      Common.Network.PostType
                      Common.Network.SiteType
                      Common.Network.ThreadType
                      Network.SpamNoticer
                      CliSettings


    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base,
                      aeson,
                      bytestring,
                      cmdargs,
                      directory,
                      filepath,
                      containers,
                      text,
                      http-client,
                      http-conduit,
                      safe-exceptions,
                      http-types,
                      time,
                      cryptonite,
                      memory,
                      mime-types,
                      perceptual-hash,
                      async,
                      temporary,
                      stm,
                      random,
                      transformers,
                      vector

    -- Directories containing source files.
    hs-source-dirs:   src

    -- Base language which the package is written in.
    default-language: GHC2021


executable download-missing-attachments
    -- Import common warning flags.
    import:           warnings

    -- .hs or .lhs file containing the Main module.
    main-is:          DownloadMissingAttachments.hs

    -- Modules included in this executable, other than Main.
    other-modules:
                      CliSettings
                      Common.Server.ConsumerSettings
                      Network.DataClient
                      BoardsType
                      Common.AttachmentType
                      Common.Network.BoardType
                      Common.Network.HttpClient
                      Common.Network.PostType
                      Common.Network.SiteType
                      Common.Network.ThreadType
                      Common.Parsing.FlexibleJsonResponseParser
                      Common.PostsType
                      Common.Server.JSONSettings
                      Network.DataClientTypes
                      Network.GetLatestPostsPerBoardResponse
                      SitesType
                      ThreadType
                      BoardQueueElem
                      ClientAPI
                      Clients.LainJSONClient
                      Clients.TinyboardHTML
                      Data.WordUtil
                      Hash
                      Lib
                      Lib2
                      Network.Api.JSONCommonTypes
                      Network.Api.JSONExtraFile
                      Network.Api.JSONParsing
                      Network.Api.JSONPost
                      PriorityQueue
                      Sync

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base,
                      text,
                      aeson,
                      cmdargs,
                      bytestring,
                      time,
                      safe-exceptions,
                      http-types,
                      http-conduit,
                      http-client,
                      vector,
                      temporary,
                      memory,
                      crypton,
                      random,
                      perceptual-hash,
                      mime-types,
                      containers,
                      filepath,
                      directory,
                      transformers,
                      stm

    -- Directories containing source files.
    hs-source-dirs:   src

    -- Base language which the package is written in.
    default-language: GHC2021
